{
  "name": "senannotate",
  "version": "0.8.5",
  "private": true,
  "description": "Chrome extension: click any element on any website, annotate it, and hand an AI coding agent the exact element, DOM path and diagnostics. Adds Vue component and source data when the page is a Vue app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node test/measure.mjs",
    "build": "node scripts/make-icons.mjs && node build.mjs",
    "dev": "node scripts/make-icons.mjs && node build.mjs --watch",
    "test": "npm run build && node test/measure.mjs && node test/e2e.mjs && node test/upgrade.mjs",
    "test:upgrade": "npm run build && node test/upgrade.mjs",
    "verify:sites": "npm run build && node test/verify-real-sites.mjs",
    "verify:tracer": "npm run build && node test/verify-tracer.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "changelog": "node scripts/changelog.mjs",
    "assets": "npm run build && node scripts/store-assets.mjs",
    "clean": "rm -rf dist",
    "wiki:assets": "npm run build && node scripts/wiki-assets.mjs",
    "wiki:sync": "node scripts/wiki-sync.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
