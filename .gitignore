# No trailing slash on these two: with one, git ignores only a *directory* of that name,
# and a symlink called node_modules (a worktree pointing at the main checkout's) slips
# through — which is how both were once committed, pointing at paths on one machine.
node_modules
dist/
dist-mcp/
senannotate-mcp-*.mjs
.pack/
senannotate-*.zip
# `scripts/pack.mjs` stages the unpacked extension in a directory of the same name
# before zipping it. It cleans up after itself, but a `git add` racing a pack does not.
senannotate-*/

# Generated by `npm run icons` from scripts/make-icons.mjs
static/icons/

# Copied out of the monorepo by test/e2e.mjs on first run
test/fixtures/vendor/

# Built by test/build-prod-fixtures.mjs
test/fixtures/prod

# Written by the test/verify-*.mjs scripts
test/screenshots/

# Claude Code scratch space — agent worktrees live here
.claude/

# Generated by scripts/store-assets.mjs
store/out/

# macOS
.DS_Store

#IDE
.idea